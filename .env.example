# ============================================================
# LLM_Bot_FX v9.3 - example configuration
# ============================================================
# Copy:  cp .env.example .env && chmod 600 .env     (.env is git-ignored)
# Format: KEY=VALUE, one per line. No inline comments, no shell expansion.
# Anything already exported in your shell overrides this file.
# Commented-out lines show the built-in default.

# --- Safety -----------------------------------------------------------------
# true = orders are logged but NEVER sent. false = orders are sent to the
# account the MT5 terminal is logged into (use a DEMO account first).
DRY_RUN=true

# --- llmspy gateway ---------------------------------------------------------
# One OpenAI-chat-completions endpoint for every model call.
LLMSPY_BASE_URL=http://localhost:8000/v1/chat/completions
# Ordered model chain, tier 0 first. This is the ONLY place models are configured.
LLMSPY_MODELS=gpt-oss-20b
# To compare two models (second one is called when tier 0 confidence is below the threshold):
#LLMSPY_MODELS=phi-4-mini-reasoning,gpt-oss-20b
# Max tokens per answer (reasoning models also spend tokens thinking)
#LLMSPY_MAX_TOKENS=1500
# Per-call HTTP timeout, capped by the per-candle budget (M15: 40 s)
#LLMSPY_TIMEOUT_SEC=40
# Minutes to keep the tier-0 model loaded in Ollama (0 = Ollama default)
#KEEP_LOCAL_ALIVE=0
#LLM_MAX_LATENCY_SEC=0

# --- Escalation -------------------------------------------------------------
#ESCALATION_ENABLED=true
# replace = if tier 0 confidence < threshold, the next tier's answer is used
#           (both answers are logged -> compare models in trade_log.jsonl)
# confirm = tier 0 decides; next tier is called only for candidate trades and
#           can veto (threshold is not used)
#ESCALATION_MODE=replace
#ESCALATION_CONFIDENCE_THRESHOLD=0.80
#ESCALATION_SHARE_LOCAL_ANSWER=false

# --- Instrument & timeframe -------------------------------------------------
TRADE_SYMBOL=EURUSD
# M1 | M5 | M15 | M30 | H1 | H4
TRADE_TIMEFRAME=M15
# MT5 bar times are BROKER SERVER time. Shift so the prompt shows real UTC,
# e.g. -3 for a UTC+3 broker. Display only; verify against the wall clock.
#BROKER_UTC_OFFSET_HOURS=0
# Changing this orphans positions opened under the old number
#MAGIC_NUMBER=260922

# --- Entry rules ------------------------------------------------------------
MAX_POSITIONS_PER_DIRECTION=1
# Minutes before another same-direction entry is allowed (0 = off)
#MIN_ENTRY_GAP_MIN=30
# Refuse a BUY while SELLs are open and vice versa
#BLOCK_OPPOSITE_SIDE=true
# Minimum confidence of the final answer to trade
MIN_CONFIDENCE=0.75
# Block a trade when spread > this fraction of ATR
#MAX_SPREAD_ATR_RATIO=0.35

# --- Sizing ------------------------------------------------------------------
# >0 = fixed lot, bypasses risk-% sizing. 0 = risk based.
FIXED_LOT_SIZE=0.01
#STARTING_RISK_PCT=0.25
#MAX_RISK_PCT=1.5
#RISK_STEP_PCT=0.15
#DAILY_LOSS_LIMIT_PCT=3.0

# --- Candles / prompt --------------------------------------------------------
# Must be >= 22
#LOOKBACK_CANDLES=50
PROMPT_BARS=8
# true = prompt also shows open-position counts and daily P&L (not recommended)
#PROMPT_INCLUDE_POSITIONS=false

# --- Stops (ATR multiples) ----------------------------------------------------
#ATR_SL_MULTIPLIER=2.0
#ATR_TP_MULTIPLIER=4.0
#EXTENDED_TP_ATR_MULT=6.0
#MAX_TP_EXTENSION_ATR_MULT=10.0
#TRAIL_ACTIVATION_ATR_MULT=1.5
# Stop trails this many ATR behind the peak. Very small values (<1.5) cap
# winners near the activation level; measure before using them.
#CHANDELIER_ATR_MULT=3.0
# Minimum SL improvement (fraction of ATR) before a modify request is sent
#TRAIL_SL_MIN_STEP_ATR_FRACTION=0.1

# --- Wine / MT5 (Linux) -------------------------------------------------------
#WINEPREFIX=/home/you/.wine
