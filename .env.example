# ============================================================
# LLM_Bot_FX - example configuration
# ============================================================
# Copy to `.env` and edit:   cp .env.example .env && chmod 600 .env
# `.env` is git-ignored. NEVER commit real API keys.
#
# Format: KEY=VALUE, one per line. No inline comments, no shell expansion.
# Quote values that contain spaces or JSON, e.g. KEY='{"a": 1}'.
# Anything already exported in your shell overrides this file.
# Commented-out lines show the built-in default.

# --- Safety: paper trading is the default -------------------------------
# true  = orders are logged/printed but NEVER sent to the broker
# false = LIVE orders. Only after you've watched dry-run behave for a while.
DRY_RUN=true

# --- Ollama (local model) ------------------------------------------------
# Host/IP of the machine running Ollama, and its port (Ollama default 11434).
TRUENAS_IP=localhost
OLLAMA_PORT=11434
# Leave unset to auto-detect (running model -> first installed -> qwen2.5:3b)
#OLLAMA_MODEL=phi4-mini
#OLLAMA_NUM_THREAD=3
#OLLAMA_NUM_CTX=2048
#OLLAMA_NUM_PREDICT=128
# 0 = per-timeframe budget table (M1:10s ... H1/H4:90s); >0 overrides it
#LLM_MAX_LATENCY_SEC=0

# --- Instrument & timeframe ----------------------------------------------
# Symbol exactly as your broker spells it (brokers sometimes add a suffix, e.g. EURUSD.a)
TRADE_SYMBOL=EURUSD
# M1 | M5 | M15 | M30 | H1 | H4.   Higher-timeframe bias: M1-M30 -> H1, H1 -> H4, H4 -> D1
TRADE_TIMEFRAME=M15
# Display-only shift for timestamps shown to the LLM (your broker's UTC offset, e.g. 2 or 3)
#BROKER_UTC_OFFSET_HOURS=0
# Tags this bot's orders. Changing it orphans any positions opened under the old number.
#MAGIC_NUMBER=260922

# --- Position sizing & risk ----------------------------------------------
# Max simultaneous positions PER DIRECTION (BUY and SELL counted separately).
# Remember worst-case exposure = this x 2 x risk per trade.
MAX_POSITIONS_PER_DIRECTION=1
# >0 = every trade uses exactly this lot size (bypasses risk-% sizing). 0 = risk-based.
FIXED_LOT_SIZE=0.01
# Risk-based sizing (used only when FIXED_LOT_SIZE=0): % of equity risked per trade
#STARTING_RISK_PCT=0.25
#MAX_RISK_PCT=1.5
#RISK_STEP_PCT=0.15
# New trades are halted for the rest of the UTC day at this drawdown %
#DAILY_LOSS_LIMIT_PCT=3.0
# Minimum confidence (of whichever model's answer is used) to place a trade
#MIN_CONFIDENCE=0.75

# --- Candles / prompt ------------------------------------------------------
# Candles fetched for indicators. Must be >= 22 or EMA21/RSI/ATR return None -> HOLD.
#LOOKBACK_CANDLES=50
# Closed candles shown to the LLM (smaller = faster inference)
#PROMPT_BARS=8

# --- Initial SL/TP (ATR multiples, set once at entry) -----------------------
#ATR_SL_MULTIPLIER=2.0
#ATR_TP_MULTIPLIER=4.0
# After trailing activates, TP is pushed to ATR*this from price, capped at ATR*MAX from entry
#EXTENDED_TP_ATR_MULT=6.0
#MAX_TP_EXTENSION_ATR_MULT=10.0

# --- Chandelier Exit trailing stop -------------------------------------------
# Peak profit (in ATR, from entry) needed before the stop starts trailing
#TRAIL_ACTIVATION_ATR_MULT=1.5
# Stop sits this many ATR behind the highest (BUY) / lowest (SELL) price since entry
#CHANDELIER_ATR_MULT=3.0

# --- Cloud escalation ---------------------------------------------------------
# When the local model's confidence is below the threshold, cloud providers are asked
# (in order: Groq, Cerebras, OpenRouter) for a second opinion. A provider is used only
# if its API key is set. Leave a key empty to skip that provider.
#ESCALATION_ENABLED=true
#ESCALATION_CONFIDENCE_THRESHOLD=0.80
# false = cloud model forms an independent opinion; true = it also sees the local answer
#ESCALATION_SHARE_LOCAL_ANSWER=false
#CLOUD_TIMEOUT_SEC=40

# Groq - https://console.groq.com/keys
GROQ_API_KEY=
#GROQ_MODEL=qwen/qwen3.8-27b
#GROQ_TIMEOUT_SEC=40
# Optional provider-specific request fields as a JSON object (see the provider's docs).
# Reasoning models are slow/verbose; you may want to limit their reasoning, e.g.:
#GROQ_EXTRA_PARAMS='{"reasoning_effort": "low"}'

# Cerebras - https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
#CEREBRAS_MODEL=llama3.1-8b
#CEREBRAS_TIMEOUT_SEC=20

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=
#OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#OPENROUTER_TIMEOUT_SEC=20

# Local Gateway 
#LOCALCLOUD_ENABLED="true"
#LOCALCLOUD_BASE_URL=""  
#LOCALCLOUD_MODEL=""
#LOCALCLOUD_TIMEOUT_SEC=40


# --- Wine / MT5 -------------------------------------------------------------------
# Wine prefix where MetaTrader 5 and Windows Python are installed
#WINEPREFIX=/home/you/.mt5
